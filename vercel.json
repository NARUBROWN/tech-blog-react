{
    "functions": {
        "api/home-share.js": {
            "includeFiles": "dist/index.html"
        },
        "api/post-share.js": {
            "includeFiles": "dist/index.html"
        }
    },
    "routes": [
        {
            "src": "^/$",
            "dest": "/api/home-share"
        }
    ],
    "rewrites": [
        {
            "source": "/post/share/:id",
            "destination": "/api/post-share?id=:id"
        },
        {
            "source": "/api/v1/:path*",
            "destination": "https://api.na2ru2.me/api/v1/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
